# Runtime mode: development, test, or production.
NODE_ENV=development

# Server-only pooled PostgreSQL connection string used by the application.
DATABASE_URL=

# Optional direct/session PostgreSQL URL for migrations. Falls back to
# DATABASE_URL locally. Prefer Supabase's direct URL for migration commands.
DATABASE_MIGRATION_URL=

# Server-side Supabase configuration. Never expose the service-role key.
SUPABASE_URL=https://your-project-reference.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase settings. Only NEXT_PUBLIC_* values reach client code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-reference.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Retell credential. Never prefix this with NEXT_PUBLIC_.
RETELL_API_KEY=

# Optional server-only secret used by the Retell event ingestion endpoint.
RETELL_WEBHOOK_SECRET=

# Optional local-development fallback for simulating Retell custom tools.
# Production Retell requests should use X-Retell-Signature verification.
RETELL_VOICE_TOOL_SECRET=

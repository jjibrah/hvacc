# Runtime mode: development, test, or production.
NODE_ENV=development

# Server-only PostgreSQL connection string from the isolated Supabase project.
DATABASE_URL=

# Server-side Supabase configuration. Never expose the service-role key.
SUPABASE_URL=https://your-project-reference.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe Supabase settings. Only NEXT_PUBLIC_* values reach client code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-reference.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Retell credential. Never prefix this with NEXT_PUBLIC_.
RETELL_API_KEY=
